# DentalCRM — production environment template.
#
# .env.example is the LOCAL DEVELOPMENT template (APP_DEBUG=true, mail to
# the log driver). Copy THIS file, not that one, for a real deployment.
#
# Work through the "Deploying" checklist in README.md alongside this file —
# in particular the first-user bootstrapping order, because the app has no
# seeded login and no admin-side "create user" screen. A deployer who
# copies this verbatim and skips that section has a running application
# nobody can log into.

APP_NAME="Harborview Dental Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinic.example
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# daily + error: with the log mail driver every AppointmentLookupLink body
# — including a live 30-minute signed URL — was written verbatim to a
# single file that grew forever. Moving mail off `log` (below) is the real
# fix; rotation and level are defence in depth.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dentalcrm
DB_USERNAME=
DB_PASSWORD=

# SESSION_ENCRYPT: the driver is `database`, so session payloads — which
#   include flash old-input from patient and prescription forms, i.e.
#   patient names and emails — otherwise sit in the sessions table in
#   base64 plaintext, readable from any database backup.
# SESSION_LIFETIME / EXPIRE_ON_CLOSE: a front-desk terminal is shared and
#   walked away from. A 120-minute idle session that survives closing the
#   browser is the wrong default for one holding patient records.
# SESSION_SAME_SITE: the staff app has no cross-site entry point, so `lax`
#   buys nothing.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Comma-separated proxy IPs, or * behind a trusted load balancer.
# MUST be set if the app sits behind a reverse proxy or load balancer:
# without it every throttle limiter collapses into one global bucket
# (six requests from anyone locks out the whole clinic) and signed URLs
# are generated with http://, which then fail validation over https://.
TRUSTED_PROXIES=

# Ships blank on purpose: blank disables self-registration entirely, and a
# deployer must not inherit the example code that is public in this
# repository. See the README checklist for the bootstrapping order.
REGISTRATION_CODE=

# Real SMTP, not `log`. See LOG_LEVEL above for why that matters.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@clinic.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
